{
    "name": "Tasks",
    "short_name": "Tasks",
    "description": "Minimal markdown task manager with rich formatting, multiple pages, and full offline support",
    "start_url": ".",
    "id": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#0c0a09",
    "theme_color": "#3b82f6",
    "lang": "en",
    "dir": "ltr",
    "categories": ["productivity", "utilities"],
    "icons": [
        {
            "src": "icons/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "icons/favicon-48x48.png",
            "sizes": "48x48",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/favicon-64x64.png",
            "sizes": "64x64",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/favicon-128x128.png",
            "sizes": "128x128",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/favicon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/favicon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/favicon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "screenshots": [
        {
            "src": "card.png",
            "sizes": "1200x630",
            "type": "image/png",
            "form_factor": "wide",
            "label": "Tasks editor with markdown formatting"
        }
    ],
    "shortcuts": [
        {
            "name": "New Page",
            "short_name": "New",
            "url": "./?new-page",
            "description": "Create a new page",
            "icons": [
                {
                    "src": "icons/favicon-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ],
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "handle_links": "preferred",
    "prefer_related_applications": false,
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "text/markdown": [".md", ".markdown", ".txt"]
            }
        }
    ],
    "share_target": {
        "action": "/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },
    "edge_side_panel": {
        "preferred_width": 480
    }
}
